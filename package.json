{
  "name": "dsh-model-manager",
  "version": "0.17.0",
  "description": "DSH 模型管理：第三方模型提供商（分组与排序）、服务商级本地 HTTP 代理、模型推理程度、子代理推理程度与并发，一处管理；含模型联通测试、并发压测、子代理派遣模拟/实测，模型重定向与服务商自动故障切换，子代理会话内单独切换模型，以及按服务商/模型/会话的 token 用量与费用估算统计。",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek", "harness", "model", "provider", "reasoning"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "undici": "^7.30.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
